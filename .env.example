# Copy values into your shell or scheduler. .env is not loaded automatically.
# Empty provider keeps news disabled; rss needs no key and has limited coverage.
NEWS_PROVIDER=
NEWS_API_KEY=
# rules = conservative, transparent extraction without a key.
# openai = strict evidence-backed structured output; requires both settings below.
NEWS_EXTRACTION=rules
LLM_API_KEY=
LLM_MODEL=
# Optional local storage override
STRYKTIPS_NEWS_DIR=
# Public read-only coupon/results provider; no API key required.
STRYKTIPS_LIVE_ENABLED=true
STRYKTIPS_LIVE_DIR=
# Production requires persistent Postgres and exact HTTPS frontend origins.
ENVIRONMENT=development
DATABASE_URL=
ODDS_API_KEY=
ODDS_REGIONS=uk
MIN_BOOKMAKERS_FOR_CONSENSUS=3
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Optional server-only token for shared data mutations. Never send to Angular.
ADMIN_API_TOKEN=
# Public frontend build setting, normally configured as GitHub Actions variable.
API_BASE_URL=
